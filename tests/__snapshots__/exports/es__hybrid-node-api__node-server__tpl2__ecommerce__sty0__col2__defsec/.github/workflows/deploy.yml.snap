name: Integración y verificación continua

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar código
        uses: actions/checkout@v7
      - name: Configurar Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 24
      # npm install (no npm ci): el proyecto exportado no incluye package-lock.json
      - name: Instalar dependencias
        run: npm install
      - name: Verificar TypeScript y compilación
        run: npm run build
