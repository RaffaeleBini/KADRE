# Puerto del servidor local
PORT=3000

# Cadena de conexión PostgreSQL (p. ej. Neon, con ?sslmode=require)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/mi_bd"

# Firma de las sesiones del área /admin: al menos 32 caracteres aleatorios. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
