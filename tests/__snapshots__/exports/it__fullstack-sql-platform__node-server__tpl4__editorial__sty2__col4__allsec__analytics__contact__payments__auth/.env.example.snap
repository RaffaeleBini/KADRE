# Porta del server locale
PORT=3000

# Stringa di connessione PostgreSQL (es. Neon, con ?sslmode=require)
DATABASE_URL="postgresql://utente:password@localhost:5432/mio_db"

# Invio del modulo di contatto con Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Mittente: con dominio verificato su Resend; vuoto = onboarding@resend.dev (solo prova)
CONTACT_FROM_EMAIL=

# Pagamenti con Stripe (https://dashboard.stripe.com/apikeys): usa sk_test_… per provare
STRIPE_SECRET_KEY=
# URL pubblico del sito (es. https://tuodominio.com). Vuoto = si ricava dalla richiesta
SITE_URL=

# Firma delle sessioni dell’area /admin: almeno 32 caratteri casuali. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
