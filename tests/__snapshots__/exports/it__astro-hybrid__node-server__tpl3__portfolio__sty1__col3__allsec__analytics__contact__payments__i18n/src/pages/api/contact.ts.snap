import type { APIRoute } from 'astro';
import { RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL } from 'astro:env/server';
import { parseContact, sendContactEmail } from '../../lib/contactEmail';

// Eseguito sul server a ogni richiesta (non generato in build).
export const prerender = false;

export const POST: APIRoute = async ({ request }) => {
  const parsed = parseContact(await request.json().catch(() => null));
  if (!parsed.ok) return Response.json({ error: parsed.error }, { status: 400 });
  // Campo trappola riempito: si risponde "ok" senza inviare nulla.
  if (parsed.spam) return Response.json({ received: true }, { status: 201 });
  const result = await sendContactEmail({ RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL }, parsed.data);
  if (result === 'unconfigured') {
    return Response.json({ error: 'Invio email non configurato (vedi README).' }, { status: 503 });
  }
  if (result === 'failed') {
    return Response.json({ error: 'Il servizio email non ha accettato il messaggio.' }, { status: 502 });
  }
  return Response.json({ received: true }, { status: 201 });
};
