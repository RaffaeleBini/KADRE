@import "tailwindcss";

:root {
  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'DM Sans', sans-serif;
  --color-bg: #F4F5F7;
  --color-surface: #FFFFFF;
  --color-surface-alt: #EAECEF;
  --color-text: #111318;
  --color-text-muted: #4F5969;
  --color-accent: #F5C400;
  --color-accent-text: #0A0B0D;
  --color-border: #D4D9E2;
  --radius-card: 4px;
  --radius-btn: 4px;
  --border-w: 1px;
  --heading-tracking: -0.025em;
  --space-section: 6.5rem;
}

html {
  scroll-behavior: smooth;
  background-color: var(--color-bg);
  color: var(--color-text);
}
