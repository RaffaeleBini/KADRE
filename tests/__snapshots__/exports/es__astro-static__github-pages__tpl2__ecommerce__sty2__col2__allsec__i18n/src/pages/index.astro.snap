---
import '../index.css';
import config from '../data/siteConfig.json';
import content from '../data/siteContent.json';
import { Site } from '../site/Site';
import type { SiteConfig, SiteContent } from '../site/types';
import { getRelativeLocaleUrl } from 'astro:i18n';

// El compilador comprueba el contenido contra SiteContent (npm run check).
// Selector de idioma: getRelativeLocaleUrl tiene en cuenta base (GitHub Pages).
const languages = [
  { code: 'es', label: 'ES', href: getRelativeLocaleUrl('es'), current: true },
  { code: 'it', label: 'IT', href: getRelativeLocaleUrl('it'), current: false },
];
const siteContent: SiteContent = content;
const siteConfig: SiteConfig = { ...(config as SiteConfig), languages };
// El título y la descripción siguen el contenido de cada idioma.
const title = siteContent.brandName + ' — ' + siteContent.tagline;
const description = siteContent.heroSubheadline;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- HTML generado al compilar; client:load hace interactivos las FAQ y el formulario. -->
    <Site client:load content={siteContent} config={siteConfig} />
  </body>
</html>
