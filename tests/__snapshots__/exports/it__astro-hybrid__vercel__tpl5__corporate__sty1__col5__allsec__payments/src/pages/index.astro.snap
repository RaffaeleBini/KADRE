---
import '../index.css';
import config from '../data/siteConfig.json';
import content from '../data/siteContent.json';
import { Site } from '../site/Site';
import type { SiteConfig, SiteContent } from '../site/types';

// Il contenuto viene verificato contro SiteContent dal compilatore (npm run check).
const siteContent: SiteContent = content;
const siteConfig = config as SiteConfig;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Italia Precisione Industriale — Automazione e manifattura avanzata</title>
    <meta name="description" content="Affianchiamo i produttori europei nella digitalizzazione di impianto, controllo metrologico e manutenzione predittiva con risultati misurabili." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- HTML generato in build; client:load rende interattivi FAQ e modulo. -->
    <Site client:load content={siteContent} config={siteConfig} />
  </body>
</html>
